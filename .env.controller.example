# Runtime contract for service-controller. Inject these variables in K3s.
NODE_ENV=production
PORT=3000
MONGO_URL=mongodb://mongo:27017/hvwm?replicaSet=rs0
CORS_ORIGIN=https://app.openhvx.local

# Required: authenticated AMQP URI. Percent-encode credential components.
RMQ_URL=
# Must agree with the agent queue declarations; migrate before changing type.
AMQP_QUEUE_TYPE=classic
JOBS_EXCHANGE=jobs
TELEMETRY_EXCHANGE=agent.telemetry
RESULTS_EXCHANGE=results
AMQP_CONNECT_MAX_ATTEMPTS=6

# Required: same Secret value as gateway; at least 32 characters.
INTERNAL_API_SECRET=
# Stable encryption secret, at least 32 characters, shared by all controllers.
# If omitted, the code derives it from INTERNAL_API_SECRET. Keep for restores.
# OUTBOX_ENCRYPTION_KEY=

# Required for console operations: same respective values as ws-broker.
JWT_AGENT_SECRET=
JWT_BROWSER_SECRET=
# Public endpoints reachable by browser and agent respectively; not pod URLs.
PUBLIC_WS_BASE=wss://console.openhvx.local/api
BROKER_WS_BASE=wss://ws.openhvx.local
# Optional default agent for storage operations.
# STORAGE_CONTROLLER_AGENT_ID=storage-controller-1

AGENT_STALE_MS=300000
AGENT_FRESHNESS_SEC=300
INVENTORY_MAX_AGE_MS=300000
IMAGES_TTL_MS=5000
QUOTA_REAPER_INTERVAL_MS=300000
QUOTA_REAPER_BATCH=200
ELECTION_WEIGHT_CPU=0.6
ELECTION_WEIGHT_MEM=0.4
LOG_ENABLED=1
LOG_LEVEL=info
LOG_JSON=1
LOG_SERVICE_NAME=controller
