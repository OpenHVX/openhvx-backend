{
    "name": "hvwm-controller",
    "version": "0.1.0",
    "private": true,
    "main": "dist/app.js",
    "scripts": {
        "start": "node dist/app.js",
        "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
        "build": "tsc",
        "lint": "tsc --noEmit",
        "test": "node --test -r ts-node/register src/tests/unit/*.test.ts",
        "migrate:inventory-uniqueness": "ts-node src/scripts/dedupeInventories.ts",
        "test:integration": "npm run build --prefix ../service-ws-broker && npm run build --prefix ../service-api-gateway && node --test -r ts-node/register src/tests/integration/*.test.ts",
        "migrate:distributed": "ts-node src/scripts/migrateDistributed.ts",
        "outbox:replay": "ts-node src/scripts/replayOutbox.ts"
    },
    "dependencies": {
        "amqplib": "^0.10.3",
        "cors": "^2.8.5",
        "dotenv": "^17.2.1",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.6.0",
        "morgan": "^1.10.0",
        "ws": "^8.18.3"
    },
    "devDependencies": {
        "@types/amqplib": "^0.10.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.5",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mongoose": "^5.11.96",
        "@types/morgan": "^1.9.10",
        "@types/node": "^24.9.2",
        "@types/ws": "^8.5.12",
        "mongodb-memory-server": "^11.3.0",
        "nodemon": "^3.1.0",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.9.3"
    }
}
