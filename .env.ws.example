# Runtime contract for service-ws-broker. Inject these variables in K3s.
NODE_ENV=production
PORT=8081
# Same application database as controller, including replica set and credentials.
MONGO_URL=mongodb://mongo:27017/hvwm?replicaSet=rs0

# Unique per replica. All brokers receive the same allowlist of peer URLs.
# Example for one StatefulSet replica; extend the map for every broker.
BROKER_ID=broker-0
BROKER_PEERS={"broker-0":"http://broker-0.brokers:8081"}

# Required: same respective Secret values as controller.
JWT_AGENT_SECRET=
JWT_BROWSER_SECRET=
# Browser page origins, not the WebSocket endpoint. Comma-separated exact values.
# Empty disables the origin allowlist; tickets are still verified.
WS_ORIGINS=https://app.openhvx.local
MAX_TUNNELS=1000
MAX_TUNNELS_PER_IP=10
BROWSER_WAIT_MS=10000
