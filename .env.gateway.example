# Runtime contract for service-api-gateway. Inject these variables in K3s.
NODE_ENV=production
PORT=8080
AUTH_URL=http://auth:4000
CONTROLLER_URL=http://controller:3000
BROKER_URL=http://ws-broker:8081
# Comma-separated exact frontend origins, without trailing slashes.
CORS_ORIGIN=https://app.openhvx.local
ENABLE_APIDOCS=false
GW_DEBUG=false

# Required: same Secret value as controller; at least 32 characters.
INTERNAL_API_SECRET=
