# Runtime contract for service-auth. Inject these variables in K3s.
# This file contains no usable secrets. Never deploy unchanged.
NODE_ENV=production
PORT=4000
MONGO_URL=mongodb://mongo:27017/hvwm_auth?replicaSet=rs0
CORS_ORIGIN=https://app.openhvx.local

# Required: two distinct random secrets, at least 32 characters each.
JWT_TENANT_SECRET=
JWT_ADMIN_SECRET=
JWT_TENANT_ISS=auth-service/tenant
JWT_TENANT_AUD=api://tenant
JWT_TENANT_EXPIRES=8h
JWT_ADMIN_ISS=auth-service/admin
JWT_ADMIN_AUD=api://admin
JWT_ADMIN_EXPIRES=30m

# Admin bootstrap: enable only while creating the first administrator.
REGISTER_ENABLED=false
REGISTER_API_KEY=
# Optional tenant registration key; absent means authenticated registration only.
TENANT_REGISTER_APIKEY=
AUTH_DEBUG=false
# Optional legacy database override; prefer the database in MONGO_URL.
# MONGO_DB=hvwm_auth
