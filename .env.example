# Optional local Compose settings ONLY. Not a K3s runtime configuration.
# See .env.{auth,gateway,controller,ws}.example for the service contracts.
# Compose injects this same secret into gateway and controller.
INTERNAL_API_SECRET=
NODE_ENV=development
RABBITMQ_DEFAULT_USER=openhvx
# URL-safe password: Compose builds RMQ_URL from these credentials.
# Empty uses the development default; production refuses that default.
RABBITMQ_DEFAULT_PASS=

# Optional Podman override socket (not consumed by backend services).
# PODMAN_SOCKET_PATH=/run/podman/podman.sock
